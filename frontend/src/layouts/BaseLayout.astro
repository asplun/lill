---
/**
 * lill 前台外壳 —— 与主题完全无关
 * 只负责：<html>/<head>/<body> 骨架 + 把页面类型告诉主题引擎
 * 具体长什么样，100% 由 themes/<激活主题>/<type>.html 决定
 */
export interface Props {
  page?: string;   // index | post | page | archive | category | tag | search | 404
  title?: string;
}
const { page = 'index', title = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style is:global>
    .lill-loading{display:flex;align-items:center;justify-content:center;min-height:60vh}
    .lill-spinner{width:28px;height:28px;border:3px solid #e2e8f0;border-top-color:#4f46e5;border-radius:50%;animation:lill-spin .7s linear infinite;display:inline-block}
    @keyframes lill-spin{to{transform:rotate(360deg)}}
    .lill-error{max-width:560px;margin:80px auto;text-align:center;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Noto Sans SC',sans-serif;color:#334155}
    .lill-error h2{font-size:22px;margin-bottom:10px}
    .lill-error p{color:#64748b;margin-bottom:8px}
  </style>
</head>
<body>
  <div id="lill-app" data-page={page}>
    <div class="lill-loading"><span class="lill-spinner"></span></div>
  </div>
  <script is:inline src="/api.js"></script>
  <script is:inline src="/theme.js"></script>
</body>
</html>
