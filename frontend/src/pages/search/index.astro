---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索">
  <h2 class="page-heading" id="search-title">搜索</h2>
  <div id="search-results"><div class="loading"><div class="spinner"></div></div></div>
</BaseLayout>

<script>
  for (let i = 0; i < 300 && !window.lillTheme; i++) await new Promise(r => setTimeout(r, 10));
  const T = window.lillTheme;
  const API = window.lillAPI;
  await T.ready;

  const q = new URLSearchParams(location.search).get('q') || '';
  const el = document.getElementById('search-results');
  document.title = '搜索：' + q + ' - ' + (document.title.split(' - ')[1] || 'lill');
  document.getElementById('search-title').textContent = '搜索：“' + q + '”';

  if (!q) {
    el.innerHTML = '<div class="empty"><p>请输入搜索关键词</p></div>';
  } else {
    try {
      const perPage = parseInt(T.val('posts_per_page', '10')) || 10;
    const d = await API.get('/posts?keyword=' + encodeURIComponent(q) + '&pageSize=' + perPage);
      const posts = (d && d.items) || [];
      el.innerHTML = posts.length
        ? '<p style="margin-bottom:16px;color:var(--text-light);font-size:14px">共找到 ' + (d.meta.total || posts.length) + ' 篇文章</p>' + posts.map(p => T.postCard(p)).join('')
        : '<div class="empty"><p>没有找到相关文章</p></div>';
    } catch (err) {
      el.innerHTML = '<div class="empty"><p>加载失败：' + T.esc(err.message) + '</p></div>';
    }
  }
</script>
