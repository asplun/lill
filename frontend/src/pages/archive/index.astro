---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="归档">
  <h2 class="page-heading" id="archive-title">文章归档</h2>
  <div id="archive-list"><div class="loading"><div class="spinner"></div></div></div>
</BaseLayout>

<script>
  for (let i = 0; i < 300 && !window.lillTheme; i++) await new Promise(r => setTimeout(r, 10));
  const T = window.lillTheme;
  const API = window.lillAPI;
  await T.ready;

  const month = new URLSearchParams(location.search).get('month') || '';
  const el = document.getElementById('archive-list');

  try {
    const d = await API.get('/posts?pageSize=200&type=post');
    let posts = (d && d.items) || [];
    if (month) {
      posts = posts.filter(p => String(p.published_at || '').startsWith(month));
      document.getElementById('archive-title').textContent = '归档：' + month;
    }
    if (!posts.length) {
      el.innerHTML = '<div class="empty"><p>暂无文章</p></div>';
    } else {
      const groups = {};
      posts.forEach(p => {
        const ym = String(p.published_at || '').substring(0, 7) || '未知';
        (groups[ym] = groups[ym] || []).push(p);
      });
      el.innerHTML = Object.keys(groups).sort().reverse().map(ym => {
        const list = groups[ym].map(p =>
          '<li><a href="/post/' + T.esc(p.slug) + '">' + T.esc(p.title) + '</a><span>' + T.fmtDate(p.published_at) + '</span></li>').join('');
        return '<div><h3 class="archive-year">' + T.esc(ym) + '（' + groups[ym].length + '）</h3><ul class="archive-list">' + list + '</ul></div>';
      }).join('');
    }
  } catch (err) {
    el.innerHTML = '<div class="empty"><p>加载失败：' + T.esc(err.message) + '</p></div>';
  }
</script>
