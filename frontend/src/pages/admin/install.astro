---
// 独立安装向导，不加载前台主题或管理主界面
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>安装向导 - lill 博客系统</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/admin/auth.css?v=20261018-ui2">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <header class="auth-header">
      <div class="auth-brand" aria-label="lill 博客系统">
        <svg class="brand-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="m3 19 7-14M9 19l7-14m-1 14 7-14"/></svg>
        <span class="brand-name">lill</span>
        <span class="brand-version">v2.0.0</span>
      </div>
      <a class="site-link" href="/">查看站点<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a>
    </header>

    <div class="install-layout wizard">
      <aside class="auth-welcome install-intro">
        <h1>从这里，<br>开始记录。</h1>
        <p>检查运行环境，填写站点信息，再创建你的管理员账号。</p>
        <nav aria-label="安装进度">
          <ol class="steps" id="steps">
            <li class="step active" data-step="1" aria-current="step"><span class="dot" aria-hidden="true">1</span><span class="step-label">环境检查<span class="step-note">确认服务器已准备就绪</span></span></li>
            <li class="step" data-step="2"><span class="dot" aria-hidden="true">2</span><span class="step-label">站点信息<span class="step-note">为你的博客起个名字</span></span></li>
            <li class="step" data-step="3"><span class="dot" aria-hidden="true">3</span><span class="step-label">管理员<span class="step-note">设置登录账号与密码</span></span></li>
            <li class="step" data-step="4"><span class="dot" aria-hidden="true">4</span><span class="step-label">完成<span class="step-note">准备好开始第一篇记录</span></span></li>
          </ol>
        </nav>
      </aside>

      <div class="wizard-content">
        <section class="panel active" data-panel="1" aria-labelledby="panel1-title">
          <h2 id="panel1-title" tabindex="-1">欢迎使用 lill</h2>
          <p class="desc">安装前，请先确认服务器环境满足以下要求。</p>
          <ul class="check-list" id="checks" aria-label="环境检查结果" aria-busy="true">
            <li class="loading-state" role="status"><span class="spinner" aria-hidden="true"></span>正在检查运行环境…</li>
          </ul>
          <div class="alert alert-warn" id="warn1" role="alert"></div>
          <div class="actions">
            <button type="button" class="btn btn-outline" id="retryChecks" hidden>重新检查</button>
            <button type="button" class="btn btn-primary" id="next1" disabled>下一步</button>
          </div>
          <noscript><p class="error">请启用 JavaScript 后继续安装。</p></noscript>
        </section>

        <form class="panel" id="siteForm" data-panel="2" aria-labelledby="panel2-title" hidden>
          <h2 id="panel2-title" tabindex="-1">站点信息</h2>
          <p class="desc">填写你的博客名称与地址，稍后可在后台「设置」中修改。</p>
          <div class="alert alert-error" id="err2" role="alert" tabindex="-1"></div>
          <div class="form-group">
            <label for="site_name">站点名称<span class="req" aria-hidden="true">*</span></label>
            <input type="text" id="site_name" name="site_name" placeholder="我的博客" maxlength="60" required>
          </div>
          <div class="form-group">
            <label for="site_description">站点描述<span class="optional">选填</span></label>
            <input type="text" id="site_description" name="site_description" placeholder="一个轻量可扩展的博客系统" maxlength="200">
          </div>
          <div class="form-group">
            <label for="site_url">站点地址<span class="optional">选填</span></label>
            <input type="url" id="site_url" name="site_url" placeholder="https://example.com" maxlength="200" autocomplete="url" aria-describedby="site-url-hint">
            <p class="hint" id="site-url-hint">用于生成永久链接，留空则使用当前访问地址。</p>
          </div>
          <div class="actions">
            <button type="button" class="btn btn-outline" id="back2">上一步</button>
            <button type="submit" class="btn btn-primary" id="next2">下一步</button>
          </div>
        </form>

        <form class="panel" id="adminForm" action="/api/v1/install" method="post" data-panel="3" aria-labelledby="panel3-title" hidden>
          <h2 id="panel3-title" tabindex="-1">管理员账号</h2>
          <p class="desc">创建你的管理员账号，用于登录后台。</p>
          <div class="alert alert-error" id="err3" role="alert" tabindex="-1"></div>
          <div class="form-group">
            <label for="admin_username">用户名<span class="req" aria-hidden="true">*</span></label>
            <input type="text" id="admin_username" name="admin_username" placeholder="admin" minlength="3" maxlength="30" pattern="[a-zA-Z0-9_\-]{3,30}" autocomplete="username" autocapitalize="none" spellcheck="false" aria-describedby="username-hint" required>
            <p class="hint" id="username-hint">3–30 位，仅限字母、数字、下划线、短横线。</p>
          </div>
          <div class="form-group">
            <label for="admin_email">邮箱<span class="req" aria-hidden="true">*</span></label>
            <input type="email" id="admin_email" name="admin_email" placeholder="you@example.com" maxlength="120" autocomplete="email" required>
          </div>
          <div class="form-group">
            <label for="admin_password">密码<span class="req" aria-hidden="true">*</span></label>
            <input type="password" id="admin_password" name="admin_password" placeholder="至少 6 位" minlength="6" autocomplete="new-password" aria-describedby="password-hint" required>
            <p class="hint" id="password-hint">至少 6 位，建议使用不易猜到的独立密码。</p>
          </div>
          <div class="actions">
            <button type="button" class="btn btn-outline" id="back3">上一步</button>
            <button type="submit" class="btn btn-primary" id="installBtn">开始安装</button>
          </div>
        </form>

        <section class="panel" data-panel="4" aria-labelledby="panel4-title" hidden>
          <h2 id="panel4-title" tabindex="-1">正在安装</h2>
          <div id="installing" hidden>
            <p class="loading-state" role="status"><span class="spinner" aria-hidden="true"></span>正在安装，请稍候…</p>
            <p class="hint">正在保存站点信息并创建管理员账号。</p>
          </div>
          <div class="done-box" id="doneBox" hidden>
            <div class="done-mark" aria-hidden="true"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 6"/></svg></div>
            <p class="desc">lill 已成功安装，你可以开始写作了。</p>
            <dl class="install-summary">
              <div><dt>后台地址</dt><dd><a href="/admin/">/admin/</a></dd></div>
              <div><dt>默认文章</dt><dd>Hello World 已创建</dd></div>
              <div><dt>默认主题</dt><dd>默认主题已启用</dd></div>
            </dl>
            <div class="actions">
              <button type="button" class="btn btn-primary" id="goAdmin">进入管理后台</button>
            </div>
          </div>
          <div class="alert alert-error" id="err4" role="alert" tabindex="-1"></div>
          <div class="actions" id="installRetry" hidden>
            <button type="button" class="btn btn-outline" id="restartInstall">重新检查</button>
          </div>
        </section>
      </div>
    </div>
    <footer class="auth-footer"><span>lill 博客系统</span><span>记录、思考与生活。</span></footer>
  </main>

  <script is:inline src="/api.js"></script>
  <script is:inline>
  (function () {
    const api = window.lillAPI;
    let current = 1;
    let installed = false;
    let installing = false;

    function goStep(n) {
      current = n;
      document.querySelectorAll('.panel').forEach(p => {
        const active = +p.dataset.panel === n;
        p.classList.toggle('active', active);
        p.hidden = !active;
      });
      document.querySelectorAll('.step').forEach(s => {
        const sn = +s.dataset.step;
        s.classList.toggle('active', sn === n);
        s.classList.toggle('done', sn < n);
        if (sn === n) s.setAttribute('aria-current', 'step');
        else s.removeAttribute('aria-current');
      });
      document.getElementById('panel' + n + '-title').focus();
    }

    function showError(id, message, field) {
      const err = document.getElementById(id);
      err.textContent = message;
      err.className = 'alert alert-error show';
      if (field) {
        field.setAttribute('aria-invalid', 'true');
        field.focus();
      } else {
        err.focus();
      }
    }

    document.querySelectorAll('input').forEach(input => {
      input.addEventListener('input', () => input.removeAttribute('aria-invalid'));
    });

    // 使用文本节点展示后端检查内容，避免将检查详情当作 HTML。
    function checkItem(check) {
      const item = document.createElement('li');
      item.className = 'check-item';
      const icon = document.createElement('span');
      icon.className = 'ico ' + (check.pass ? 'ok' : 'no');
      icon.setAttribute('role', 'img');
      icon.setAttribute('aria-label', check.pass ? '通过' : '未通过');
      icon.innerHTML = '<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
        (check.pass ? '<path d="m5 12 4 4L19 6"/>' : '<path d="m6 6 12 12M18 6 6 18"/>') + '</svg>';
      const name = document.createElement('span');
      name.className = 'name';
      name.textContent = check.name;
      const detail = document.createElement('span');
      detail.className = 'detail';
      detail.textContent = check.detail;
      item.append(icon, name, detail);
      return item;
    }

    async function loadChecks() {
      const box = document.getElementById('checks');
      const next = document.getElementById('next1');
      const retry = document.getElementById('retryChecks');
      const warn = document.getElementById('warn1');
      next.disabled = true;
      next.textContent = '下一步';
      retry.disabled = true;
      warn.className = 'alert alert-warn';
      box.setAttribute('aria-busy', 'true');
      box.innerHTML = '<li class="loading-state" role="status"><span class="spinner" aria-hidden="true"></span>正在检查运行环境…</li>';
      try {
        const r = await api.get('/install/status', { timeout: 10000 });
        installed = !!r.installed;
        const checks = r.checks || [];
        box.replaceChildren(...checks.map(checkItem));
        if (!checks.length) {
          const empty = document.createElement('li');
          empty.className = 'loading-state';
          empty.textContent = '无检查项';
          box.append(empty);
        }
        const allPass = checks.every(c => c.pass);
        if (installed) {
          warn.className = 'alert alert-warn show';
          warn.textContent = '站点已安装，可直接登录管理后台。如需重新安装，请先清空数据库文件 backend/data/lill.db。';
          next.textContent = '前往登录';
          next.disabled = false;
          retry.hidden = true;
        } else {
          next.disabled = !allPass;
          retry.hidden = allPass;
          if (!allPass) {
            warn.className = 'alert alert-warn show';
            warn.textContent = '部分环境检查未通过，请修复后重新检查。';
          }
        }
      } catch (e) {
        box.replaceChildren(checkItem({ pass: false, name: '无法连接后端 API', detail: e.message || '请检查网络连接后重试' }));
        retry.hidden = false;
      } finally {
        retry.disabled = false;
        box.setAttribute('aria-busy', 'false');
      }
    }

    document.getElementById('retryChecks').onclick = loadChecks;
    document.getElementById('next1').onclick = () => {
      if (installed) location.href = '/admin/login/';
      else goStep(2);
    };

    document.getElementById('siteForm').addEventListener('submit', event => {
      event.preventDefault();
      const name = document.getElementById('site_name');
      const url = document.getElementById('site_url');
      if (!name.value.trim()) return showError('err2', '请填写站点名称', name);
      if (url.value.trim() && !/^https?:\/\/.+/.test(url.value.trim())) {
        return showError('err2', '站点地址必须以 http:// 或 https:// 开头', url);
      }
      document.getElementById('err2').className = 'alert alert-error';
      goStep(3);
    });
    document.getElementById('back2').onclick = () => goStep(1);
    document.getElementById('back3').onclick = () => goStep(2);

    document.getElementById('adminForm').addEventListener('submit', async event => {
      event.preventDefault();
      if (installing || current !== 3) return;
      const username = document.getElementById('admin_username').value.trim();
      const email = document.getElementById('admin_email').value.trim();
      const password = document.getElementById('admin_password').value;
      if (!/^[a-zA-Z0-9_\-]{3,30}$/.test(username)) return showError('err3', '用户名需 3-30 位，仅限字母、数字、下划线、短横线', document.getElementById('admin_username'));
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showError('err3', '请填写有效的邮箱地址', document.getElementById('admin_email'));
      if (password.length < 6) return showError('err3', '密码长度至少 6 位', document.getElementById('admin_password'));
      document.getElementById('err3').className = 'alert alert-error';

      installing = true;
      const button = document.getElementById('installBtn');
      button.disabled = true;
      button.textContent = '正在安装…';
      document.getElementById('installing').hidden = false;
      document.getElementById('doneBox').hidden = true;
      document.getElementById('installRetry').hidden = true;
      document.getElementById('err4').className = 'alert alert-error';
      document.getElementById('panel4-title').textContent = '正在安装';
      goStep(4);
      document.querySelector('[data-panel="4"]').setAttribute('aria-busy', 'true');

      try {
        const r = await api.post('/install', {
          site_name: document.getElementById('site_name').value.trim(),
          site_description: document.getElementById('site_description').value.trim(),
          site_url: document.getElementById('site_url').value.trim() || location.origin,
          admin_username: username,
          admin_email: email,
          admin_password: password,
        }, { timeout: 30000 });
        if (r && r.token) localStorage.setItem('lill_token', r.token);
        if (r && r.csrfToken) localStorage.setItem('lill_csrf_token', r.csrfToken);
        document.getElementById('doneBox').hidden = false;
        document.getElementById('panel4-title').textContent = '安装完成';
        document.querySelectorAll('.step').forEach(s => { if (+s.dataset.step <= 4) s.classList.add('done'); });
        document.getElementById('panel4-title').focus();
      } catch (e) {
        document.getElementById('panel4-title').textContent = '安装未完成';
        showError('err4', e.message || '安装失败，请重新检查后重试');
        document.getElementById('installRetry').hidden = false;
      } finally {
        installing = false;
        document.getElementById('installing').hidden = true;
        document.querySelector('[data-panel="4"]').setAttribute('aria-busy', 'false');
        button.disabled = false;
        button.textContent = '开始安装';
      }
    });

    document.getElementById('restartInstall').onclick = () => location.reload();
    document.getElementById('goAdmin').onclick = () => location.href = '/admin/';

    loadChecks();
  })();
  </script>
</body>
</html>
