---
// 独立安装向导页，不加载前台布局（对标 Typecho / WordPress 首次安装）
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>安装向导 - lill 博客系统</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style is:global>
    *{margin:0;padding:0;box-sizing:border-box}
    :root{--primary:#5e6ad2;--primary-dark:#4a54b8;--primary-bg:rgba(94,106,210,.08);--text:#1e293b;--text-light:#64748b;--border:#e2e8f0;--success:#10b981;--danger:#ef4444}
    body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Noto Sans SC',sans-serif;background:#f1f5f9;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;color:var(--text)}
    .wizard{background:#fff;border-radius:16px;box-shadow:0 8px 40px rgba(0,0,0,.08);width:100%;max-width:620px;overflow:hidden}
    .wizard-head{padding:28px 36px 0;display:flex;align-items:center;gap:12px}
    .wizard-head img{width:40px;height:40px;border-radius:11px;box-shadow:0 4px 12px rgba(94,106,210,.25)}
    .wizard-head .brand{font-size:20px;font-weight:700}
    .wizard-head .ver{font-size:11px;font-weight:600;color:var(--primary);background:var(--primary-bg);padding:2px 9px;border-radius:20px}
    .steps{display:flex;padding:24px 36px 0;gap:8px}
    .step{flex:1;text-align:center;font-size:12px;color:var(--text-light);position:relative}
    .step .dot{width:26px;height:26px;border-radius:50%;background:#e2e8f0;color:#94a3b8;display:flex;align-items:center;justify-content:center;margin:0 auto 6px;font-weight:600;font-size:12px;transition:all .25s}
    .step.active .dot{background:var(--primary);color:#fff;box-shadow:0 0 0 4px var(--primary-bg)}
    .step.done .dot{background:var(--success);color:#fff}
    .step.active{color:var(--primary);font-weight:600}
    .step-line{position:absolute;top:13px;left:calc(50% + 18px);right:calc(-50% + 18px);height:2px;background:#e2e8f0;z-index:-1}
    .step.done .step-line{background:var(--success)}
    .panel{padding:28px 36px 32px;display:none}
    .panel.active{display:block;animation:fade .25s ease}
    @keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
    .panel h2{font-size:18px;margin-bottom:6px}
    .panel .desc{font-size:13px;color:var(--text-light);margin-bottom:22px;line-height:1.7}
    .form-group{margin-bottom:16px}
    .form-group label{display:block;font-size:13px;font-weight:600;margin-bottom:6px}
    .form-group label .req{color:var(--danger);margin-left:2px}
    .form-group input{width:100%;padding:11px 14px;border:1px solid var(--border);border-radius:9px;font-size:14px;outline:none;transition:border-color .2s,box-shadow .2s}
    .form-group input:focus{border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-bg)}
    .form-group .hint{font-size:12px;color:var(--text-light);margin-top:5px}
    .check-list{border:1px solid var(--border);border-radius:10px;overflow:hidden}
    .check-item{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--border);font-size:13px}
    .check-item:last-child{border-bottom:none}
    .check-item .ico{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;color:#fff;flex-shrink:0}
    .check-item .ico.ok{background:var(--success)}
    .check-item .ico.no{background:var(--danger)}
    .check-item .name{font-weight:600}
    .check-item .detail{margin-left:auto;color:var(--text-light);font-size:12px}
    .actions{display:flex;gap:10px;margin-top:24px}
    .btn{padding:11px 22px;border-radius:9px;border:none;font-size:14px;font-weight:600;cursor:pointer;transition:all .2s}
    .btn-primary{background:var(--primary);color:#fff;flex:1}
    .btn-primary:hover:not(:disabled){background:var(--primary-dark)}
    .btn-primary:disabled{opacity:.5;cursor:not-allowed}
    .btn-outline{background:#fff;color:var(--text);border:1px solid var(--border)}
    .btn-outline:hover{background:#f8fafc}
    .alert{padding:11px 14px;border-radius:9px;font-size:13px;margin-bottom:16px;display:none}
    .alert.show{display:block}
    .alert-error{background:#fef2f2;color:#b91c1c;border:1px solid #fecaca}
    .alert-warn{background:#fffbeb;color:#b45309;border:1px solid #fde68a}
    .done-box{text-align:center;padding:16px 0}
    .done-box .big{font-size:52px;margin-bottom:12px}
    .done-box h2{font-size:20px;margin-bottom:8px}
    .done-box p{font-size:13px;color:var(--text-light);line-height:1.8}
    .done-box .info{background:var(--primary-bg);border-radius:10px;padding:14px;margin:18px 0;font-size:13px;text-align:left;line-height:1.9}
    .done-box .info code{background:#fff;padding:2px 7px;border-radius:5px;font-size:12px}
    .spinner{width:34px;height:34px;border:3px solid #e2e8f0;border-top-color:var(--primary);border-radius:50%;animation:spin .8s linear infinite;margin:30px auto}
    @keyframes spin{to{transform:rotate(360deg)}}
  </style>
</head>
<body>
  <div class="wizard">
    <div class="wizard-head">
      <img src="/logo.svg" alt="lill">
      <span class="brand">lill 博客系统</span>
      <span class="ver">v2.0.0</span>
    </div>

    <div class="steps" id="steps">
      <div class="step active" data-step="1"><div class="dot">1</div>环境检查<div class="step-line"></div></div>
      <div class="step" data-step="2"><div class="dot">2</div>站点信息<div class="step-line"></div></div>
      <div class="step" data-step="3"><div class="dot">3</div>管理员<div class="step-line"></div></div>
      <div class="step" data-step="4"><div class="dot">4</div>完成</div>
    </div>

    <!-- 步骤 1：环境检查 -->
    <div class="panel active" data-panel="1">
      <h2>欢迎使用 lill</h2>
      <p class="desc">安装前，请先确认服务器环境满足以下要求。</p>
      <div class="check-list" id="checks"><div class="spinner"></div></div>
      <div class="alert alert-warn" id="warn1"></div>
      <div class="actions">
        <button class="btn btn-primary" id="next1" disabled>下一步</button>
      </div>
    </div>

    <!-- 步骤 2：站点信息 -->
    <div class="panel" data-panel="2">
      <h2>站点信息</h2>
      <p class="desc">填写你的博客名称与地址，稍后可在后台「设置」中修改。</p>
      <div class="alert alert-error" id="err2"></div>
      <div class="form-group">
        <label>站点名称<span class="req">*</span></label>
        <input type="text" id="site_name" placeholder="我的博客" maxlength="60">
      </div>
      <div class="form-group">
        <label>站点描述</label>
        <input type="text" id="site_description" placeholder="一个轻量可扩展的博客系统" maxlength="200">
      </div>
      <div class="form-group">
        <label>站点地址</label>
        <input type="text" id="site_url" placeholder="https://example.com" maxlength="200">
        <div class="hint">用于生成永久链接，留空则使用当前访问地址</div>
      </div>
      <div class="actions">
        <button class="btn btn-outline" id="back2">上一步</button>
        <button class="btn btn-primary" id="next2">下一步</button>
      </div>
    </div>

    <!-- 步骤 3：管理员账号 -->
    <div class="panel" data-panel="3">
      <h2>管理员账号</h2>
      <p class="desc">创建你的管理员账号，用于登录后台。</p>
      <div class="alert alert-error" id="err3"></div>
      <div class="form-group">
        <label>用户名<span class="req">*</span></label>
        <input type="text" id="admin_username" placeholder="admin" maxlength="30" autocomplete="username">
        <div class="hint">3-30 位，仅限字母、数字、下划线、短横线</div>
      </div>
      <div class="form-group">
        <label>邮箱<span class="req">*</span></label>
        <input type="email" id="admin_email" placeholder="you@example.com" maxlength="120" autocomplete="email">
      </div>
      <div class="form-group">
        <label>密码<span class="req">*</span></label>
        <input type="password" id="admin_password" placeholder="至少 6 位" autocomplete="new-password">
      </div>
      <div class="actions">
        <button class="btn btn-outline" id="back3">上一步</button>
        <button class="btn btn-primary" id="installBtn">开始安装</button>
      </div>
    </div>

    <!-- 步骤 4：完成 -->
    <div class="panel" data-panel="4">
      <div id="installing" style="display:none"><div class="spinner"></div><p style="text-align:center;color:var(--text-light);font-size:13px">正在安装，请稍候…</p></div>
      <div class="done-box" id="doneBox" style="display:none">
        <div class="big">🎉</div>
        <h2>安装完成</h2>
        <p>lill 已成功安装，你可以开始写作了。</p>
        <div class="info">
          <div>后台地址：<code>/admin/</code></div>
          <div>默认文章：<code>Hello World</code> 已创建</div>
          <div>默认主题：<code>默认主题</code> 已启用</div>
        </div>
        <div class="actions" style="justify-content:center">
          <button class="btn btn-primary" id="goAdmin" style="flex:none;min-width:180px">进入管理后台</button>
        </div>
      </div>
      <div class="alert alert-error" id="err4"></div>
    </div>
  </div>

  <script is:inline src="/api.js"></script>
  <script is:inline>
  (function () {
    const api = window.lillAPI;
    let current = 1;
    let installed = false;

    function goStep(n) {
      current = n;
      document.querySelectorAll('.panel').forEach(p => p.classList.toggle('active', +p.dataset.panel === n));
      document.querySelectorAll('.step').forEach(s => {
        const sn = +s.dataset.step;
        s.classList.toggle('active', sn === n);
        s.classList.toggle('done', sn < n);
      });
    }

    // ── 步骤 1：环境检查 ──
    async function loadChecks() {
      const box = document.getElementById('checks');
      try {
        const r = await api.get('/install/status', { timeout: 10000 });
        installed = !!r.installed;
        box.innerHTML = (r.checks || []).map(c =>
          '<div class="check-item"><span class="ico ' + (c.pass ? 'ok' : 'no') + '">' + (c.pass ? '✓' : '✕') + '</span>' +
          '<span class="name">' + c.name + '</span><span class="detail">' + c.detail + '</span></div>'
        ).join('') || '<div class="check-item">无检查项</div>';
        const allPass = (r.checks || []).every(c => c.pass);
        if (installed) {
          document.getElementById('warn1').className = 'alert alert-warn show';
          document.getElementById('warn1').innerHTML = '⚠ 站点已安装。如需重新安装，请先清空数据库文件 <code>backend/data/lill.db</code>。';
          document.getElementById('next1').textContent = '前往登录';
          document.getElementById('next1').disabled = false;
          document.getElementById('next1').onclick = () => location.href = '/admin/login/';
        } else {
          document.getElementById('next1').disabled = !allPass;
          if (!allPass) {
            document.getElementById('warn1').className = 'alert alert-warn show';
            document.getElementById('warn1').textContent = '部分环境检查未通过，请修复后再继续。';
          }
          document.getElementById('next1').onclick = () => goStep(2);
        }
      } catch (e) {
        box.innerHTML = '<div class="check-item"><span class="ico no">✕</span><span class="name">无法连接后端 API</span><span class="detail">' + (e.message || '') + '</span></div>';
      }
    }

    // ── 步骤 2 → 3 ──
    document.getElementById('next2').onclick = () => {
      const name = document.getElementById('site_name').value.trim();
      const err = document.getElementById('err2');
      if (!name) { err.textContent = '请填写站点名称'; err.className = 'alert alert-error show'; return; }
      const url = document.getElementById('site_url').value.trim();
      if (url && !/^https?:\/\/.+/.test(url)) { err.textContent = '站点地址必须以 http:// 或 https:// 开头'; err.className = 'alert alert-error show'; return; }
      err.className = 'alert alert-error';
      goStep(3);
    };
    document.getElementById('back2').onclick = () => goStep(1);

    // ── 步骤 3：提交安装 ──
    document.getElementById('back3').onclick = () => goStep(2);
    document.getElementById('installBtn').onclick = async () => {
      const err = document.getElementById('err3');
      const username = document.getElementById('admin_username').value.trim();
      const email = document.getElementById('admin_email').value.trim();
      const password = document.getElementById('admin_password').value;
      const fail = (m) => { err.textContent = m; err.className = 'alert alert-error show'; };
      if (!/^[a-zA-Z0-9_\-]{3,30}$/.test(username)) return fail('用户名需 3-30 位，仅限字母、数字、下划线、短横线');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return fail('请填写有效的邮箱地址');
      if (password.length < 6) return fail('密码长度至少 6 位');
      err.className = 'alert alert-error';

      goStep(4);
      document.getElementById('installing').style.display = 'block';
      document.getElementById('doneBox').style.display = 'none';

      try {
        const r = await api.post('/install', {
          site_name: document.getElementById('site_name').value.trim(),
          site_description: document.getElementById('site_description').value.trim(),
          site_url: document.getElementById('site_url').value.trim() || location.origin,
          admin_username: username,
          admin_email: email,
          admin_password: password,
        }, { timeout: 30000 });
        if (r && r.token) localStorage.setItem('lill_token', r.token);
        document.getElementById('installing').style.display = 'none';
        document.getElementById('doneBox').style.display = 'block';
        document.querySelectorAll('.step').forEach(s => { if (+s.dataset.step <= 4) s.classList.add('done'); });
      } catch (e) {
        document.getElementById('installing').style.display = 'none';
        document.getElementById('err4').textContent = e.message || '安装失败';
        document.getElementById('err4').className = 'alert alert-error show';
        document.getElementById('doneBox').style.display = 'none';
        const back = document.createElement('div');
        back.className = 'actions';
        back.innerHTML = '<button class="btn btn-outline" onclick="location.reload()">重新开始</button>';
        document.getElementById('err4').after(back);
      }
    };

    document.getElementById('goAdmin').onclick = () => location.href = '/admin/';

    loadChecks();
  })();
  </script>
</body>
</html>
