---
// lill 管理后台 — 独立 SPA，不复用博客布局
const token = Astro.cookies.get('lill_token')?.value;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>lill 管理后台</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <script is:inline>
    // 未安装时跳转安装向导（异步检测，不阻塞正常使用）
    fetch('/api/v1/install/status').then(r => r.json()).then(d => {
      if (d && d.data && d.data.installed === false) location.replace('/admin/install/');
    }).catch(() => {});
  </script>
  <link rel="stylesheet" href="/admin/admin.css">
</head>
<body>
<div class="admin">
  <aside class="sidebar">
    <div class="sidebar-logo"><img src="/logo.svg" alt="lill" class="logo-img"><span>lill</span><em class="ver">v2.0</em></div>
    <nav class="sidebar-menu">
      <div class="menu-section">概览</div>
      <a class="menu-item active" data-page="dashboard"><span>📊</span>控制台</a>
      <div class="menu-section">内容</div>
      <a class="menu-item" data-page="posts"><span>📝</span>文章</a>
      <a class="menu-item" data-page="pages"><span>📄</span>页面</a>
      <a class="menu-item" data-page="categories"><span>📁</span>分类</a>
      <a class="menu-item" data-page="tags"><span>🏷️</span>标签</a>
      <a class="menu-item" data-page="comments"><span>💬</span>评论</a>
      <a class="menu-item" data-page="media"><span>🖼️</span>附件</a>
      <div class="menu-section">系统</div>
      <a class="menu-item" data-page="themes"><span>🎨</span>外观</a>
      <a class="menu-item" data-page="users"><span>👥</span>用户</a>
      <a class="menu-item" data-page="settings"><span>⚙️</span>设置</a>
      <a class="menu-item" data-page="logs"><span>📋</span>日志</a>
      <a class="menu-item" data-page="backup"><span>💾</span>备份</a>
      <div class="menu-section" id="plugin-menu-section" style="display:none">插件</div>
      <div id="plugin-menus"></div>
      <div class="menu-section">扩展</div>
      <a class="menu-item" data-page="plugins"><span>🔌</span>插件管理</a>
    </nav>
    <div class="sidebar-footer">
      <div class="user"><div class="avatar">A</div><span class="name" id="user-name">Admin</span></div>
      <button class="logout" id="logout-btn">退出登录</button>
      <div class="sys-badge">lill 博客系统 · v2.0.0</div>
    </div>
  </aside>

  <main class="main">
    <header class="topbar">
      <h2 id="page-title">控制台</h2>
      <div class="topbar-actions" id="topbar-actions"></div>
    </header>
    <div class="content" id="content"><div class="loading"><div class="spinner"></div></div></div>
  </main>
</div>

<script is:inline src="/api.js"></script>
<script is:inline type="module" src="/admin/app.js"></script>
</body>
</html>
