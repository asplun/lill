---
// 独立登录页，不加载前台布局
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>登录 - lill 博客</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/admin/auth.css?v=20261018-ui2">
  <script>
    // 未安装时跳转安装向导
    fetch('/api/v1/install/status').then(r => r.json()).then(d => {
      if (d && d.data && d.data.installed === false) location.replace('/admin/install/');
    }).catch(() => {});
  </script>
</head>
<body class="auth-page">
  <main class="auth-shell">
    <header class="auth-header">
      <div class="auth-brand" aria-label="lill 博客系统">
        <svg class="brand-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="m3 19 7-14M9 19l7-14m-1 14 7-14"/></svg>
        <span class="brand-name">lill</span>
      </div>
      <a class="site-link" href="/">查看站点<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a>
    </header>

    <div class="login-layout">
      <section class="auth-welcome" aria-labelledby="welcome-title">
        <h1 id="welcome-title">欢迎回来，<br>继续你的记录。</h1>
        <p>文章、草稿与读者的回应，都在这里。</p>
      </section>

      <section class="auth-form-panel" aria-labelledby="login-title">
        <h2 id="login-title">登录管理后台</h2>
        <p class="form-description">使用你的管理员账号登录。</p>
        <div id="err" class="error" role="alert" tabindex="-1" hidden></div>
        <form id="loginForm" action="/api/v1/auth/login" method="post" aria-labelledby="login-title">
          <div class="form-group">
            <label for="u">用户名或邮箱</label>
            <input type="text" id="u" name="username" placeholder="输入用户名或邮箱" autocomplete="username" autocapitalize="none" spellcheck="false" required>
          </div>
          <div class="form-group">
            <label for="p">密码</label>
            <input type="password" id="p" name="password" placeholder="输入密码" autocomplete="current-password" required>
          </div>
          <button type="submit" class="btn btn-primary login-submit" id="b" disabled>
            <span class="spinner" id="loginSpinner" aria-hidden="true" hidden></span>
            <span id="loginLabel">登录</span>
          </button>
        </form>
        <noscript><p class="error">请启用 JavaScript 后登录管理后台。</p></noscript>
      </section>
    </div>

    <footer class="auth-footer"><span>lill 博客系统</span><span>记录、思考与生活。</span></footer>
  </main>
  <script is:inline>
    const form = document.getElementById('loginForm');
    const btn = document.getElementById('b');
    const error = document.getElementById('err');
    const label = document.getElementById('loginLabel');
    const spinner = document.getElementById('loginSpinner');

    async function login(event) {
      event.preventDefault();
      if (btn.disabled) return;
      error.hidden = true;
      error.textContent = '';
      btn.disabled = true;
      form.setAttribute('aria-busy', 'true');
      label.textContent = '正在登录…';
      spinner.hidden = false;
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 15000);
      try {
        const res = await fetch('/api/v1/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          signal: controller.signal,
          body: JSON.stringify({
            username: document.getElementById('u').value,
            password: document.getElementById('p').value
          })
        });
        const data = await res.json();
        if (!res.ok || data.code !== 0) throw new Error(data.message || '登录失败，请重试');
        if (!data.data || !data.data.token) throw new Error('登录响应异常，请重试');
        localStorage.setItem('lill_token', data.data.token); if (data.data.csrfToken) localStorage.setItem('lill_csrf_token', data.data.csrfToken);
        var next = new URLSearchParams(location.search).get('next') || '';
        if (!next || next.charAt(0) !== '/' || next.charAt(1) === '/') next = '/admin/';
        location.href = next;
      } catch (e) {
        error.textContent = e.name === 'AbortError' ? '请求超时，请重试' :
          e instanceof TypeError ? '无法连接服务器，请检查网络后重试' :
          e instanceof SyntaxError ? '服务器返回异常，请稍后重试' : e.message || '登录失败，请重试';
        error.hidden = false;
        error.focus();
      } finally {
        clearTimeout(timer);
        btn.disabled = false;
        form.setAttribute('aria-busy', 'false');
        label.textContent = '登录';
        spinner.hidden = true;
      }
    }
    form.addEventListener('submit', login);
    btn.disabled = false;
  </script>
</body>
</html>
