---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="">
  <article class="post-detail" id="page-detail"><div class="loading"><div class="spinner"></div></div></article>
</BaseLayout>

<script>
  for (let i = 0; i < 300 && !window.lillTheme; i++) await new Promise(r => setTimeout(r, 10));
  const T = window.lillTheme;
  const API = window.lillAPI;
  await T.ready;

  const slug = location.pathname.split('/').filter(Boolean)[1] || '';
  const el = document.getElementById('page-detail');

  if (!slug) {
    el.innerHTML = '<div class="empty"><p>页面不存在</p></div>';
  } else {
    try {
      const page = await API.get('/posts/' + encodeURIComponent(slug));
      document.title = page.title + ' - ' + (document.title.split(' - ')[1] || 'lill');
      el.innerHTML = '<h1 class="post-title">' + T.esc(page.title) + '</h1>' +
        '<div class="post-content">' + (page.html_content || '') + '</div>';
    } catch (err) {
      el.innerHTML = '<div class="empty"><p>页面不存在或加载失败</p></div>';
    }
  }
</script>
