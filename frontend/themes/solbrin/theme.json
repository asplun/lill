{
  "id": "solbrin",
  "name": "Solbrin",
  "version": "1.0.0",
  "description": "以沉浸式影像、克制的排版和长胶囊文章选择为核心的 Lill 主题。",
  "author": "lill",
  "settingsPage": "settings.html",
  "backend": {
    "entry": "backend/index.mjs",
    "protocol": 1
  },
  "settings": [
    {
      "group": "导航",
      "key": "navigation",
      "label": "侧栏导航",
      "type": "navigation",
      "default": ["index", "archive"],
      "description": "选择并排序侧栏中的站点入口。"
    },
    {
      "group": "首页影像",
      "key": "hero_media_type",
      "label": "主视觉类型",
      "type": "select",
      "default": "image",
      "options": [
        { "value": "image", "label": "图片" },
        { "value": "video", "label": "视频" }
      ]
    },
    {
      "group": "首页影像",
      "key": "hero_image",
      "label": "桌面图片地址",
      "type": "text",
      "default": "",
      "description": "留空使用主题内置雾景图。"
    },
    {
      "group": "首页影像",
      "key": "hero_video",
      "label": "视频地址",
      "type": "text",
      "default": "",
      "description": "选择视频时使用。留空会显示封面，不播放视频。"
    },
    {
      "group": "首页影像",
      "key": "hero_poster",
      "label": "视频封面地址",
      "type": "text",
      "default": "",
      "description": "视频加载前、加载失败或减少动态效果时显示。留空使用桌面图片。"
    },
    {
      "group": "首页影像",
      "key": "hero_mobile_image",
      "label": "手机图片地址",
      "type": "text",
      "default": "",
      "description": "可选，留空使用桌面图片。"
    },
    {
      "group": "首页影像",
      "key": "hero_mobile_video",
      "label": "手机视频地址",
      "type": "text",
      "default": "",
      "description": "可选，留空使用桌面视频。"
    },
    {
      "group": "首页影像",
      "key": "hero_position",
      "label": "桌面焦点位置",
      "type": "text",
      "default": "50% 50%",
      "description": "例如 50% 50% 或 65% 45%。"
    },
    {
      "group": "首页影像",
      "key": "hero_mobile_position",
      "label": "手机焦点位置",
      "type": "text",
      "default": "50% 50%"
    },
    {
      "group": "首页影像",
      "key": "hero_tone",
      "label": "取色回退",
      "type": "select",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "自动判断" },
        { "value": "light", "label": "亮色影像" },
        { "value": "dark", "label": "暗色影像" }
      ],
      "description": "无法读取素材像素时使用。"
    },
    {
      "group": "界面",
      "key": "show_sidebar",
      "label": "显示侧栏入口",
      "type": "checkbox",
      "default": true
    },
    {
      "group": "界面",
      "key": "footer_text",
      "label": "页脚文字",
      "type": "text",
      "default": "记录设计与生活"
    },
    {
      "group": "文章",
      "key": "show_author",
      "label": "显示作者",
      "type": "checkbox",
      "default": true
    },
    {
      "group": "文章",
      "key": "show_category",
      "label": "显示分类",
      "type": "checkbox",
      "default": true
    },
    {
      "group": "文章",
      "key": "show_views",
      "label": "显示阅读量",
      "type": "checkbox",
      "default": true
    },
    {
      "group": "文章",
      "key": "show_tags",
      "label": "显示标签",
      "type": "checkbox",
      "default": true
    },
    {
      "group": "文章",
      "key": "show_prevnext",
      "label": "显示上一篇和下一篇",
      "type": "checkbox",
      "default": true
    },
    {
      "group": "文章",
      "key": "show_comment",
      "label": "显示评论区",
      "type": "checkbox",
      "default": true
    },
    {
      "group": "高级",
      "key": "custom_css",
      "label": "自定义 CSS",
      "type": "textarea",
      "default": "",
      "description": "追加到站点前台的自定义样式。"
    }
  ]
}
