# lill 博客系统 — Nginx 站点配置模板
#
# 使用前替换：
#   blog.example.com     → 你的域名
#   /www/wwwroot/lill    → 你的实际部署路径（1Panel 常见为 /opt/1panel/www/sites/lill）
#
# 宝塔：网站 → 站点 → 配置文件 → 整体替换
# 1Panel：网站 → 站点 → 配置文件 → 在 server{} 内加入 location 段（或整体替换）
#
# ⚠️ root 指向 frontend/，不是 frontend/dist/
#   后端按 THEMES_DIR = <项目根>/frontend/themes 读取主题模板，前端也通过
#   /themes/<id>/... 请求主题资源。二者必须指向同一棵树，否则会出现
#   “后台切了主题、前台还是旧样式”。
#   构建产物由 deploy.sh 同步进 frontend/（或你手动 cp -r frontend/dist/* frontend/）。

server {
    listen 80;
    server_name blog.example.com;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name blog.example.com;

    # SSL 证书（宝塔一键申请后路径类似如下；1Panel 由面板自动管理，可省略）
    ssl_certificate     /www/server/panel/vhost/cert/blog.example.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/blog.example.com/privkey.pem;

    root /www/wwwroot/lill/frontend;
    index index.html;

    # ── 后端 API 反向代理 ──
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 50M;          # 媒体上传大小上限
    }

    # ── 上传文件由 Nginx 直接读取（绕过 Node，性能更好） ──
    location /uploads/ {
        alias /www/wwwroot/lill/backend/uploads/;
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
    }

    # ── 主题与构建产物：缺失即 404，禁止回退到 index.html ──
    # 这条很容易被忽略：一旦回退成首页，主题样式/脚本 404 时会返回一段 HTML，
    # 浏览器报 "Unexpected token '<'"、CSS 静默失效，排查起来非常费劲。
    location /themes/ {
        # 主题会被手工修改，强制带 ETag 回源校验，否则改了看不到效果
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location /_astro/ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # ── 动态路由回退到各自的静态壳 ──
    location /post/     { try_files $uri $uri/ /post/index.html; }
    location /category/ { try_files $uri $uri/ /category/index.html; }
    location /tag/      { try_files $uri $uri/ /tag/index.html; }
    location /page/     { try_files $uri $uri/ /page/index.html; }
    location /search/   { try_files $uri $uri/ /search/index.html; }
    location /admin/    { try_files $uri $uri/ /admin/index.html; }

    # ── RSS Feed ──
    location = /feed.xml {
        proxy_pass http://127.0.0.1:3000/api/v1/feed;
        proxy_set_header Host $host;
    }

    location = /favicon.ico {
        try_files /favicon.svg =404;
    }

    # 应用内 404 外壳：仅内部跳转使用
    location = /404.html {
        internal;
        try_files $uri =404;
    }

    # 主题自定义页面请由主题自己的前端路由或 manifest 处理；核心不写死主题路径。

    # ── 前端静态文件 ──
    location / {
        # 路由壳与 api.js / theme.js 会被持续修改，统一回源校验
        add_header Cache-Control "no-cache";
        # 真实文件/目录优先；都不存在时落到 404 外壳，而不是首页
        try_files $uri $uri/ =404;
        error_page 404 /404.html;
    }
}

# 主题资源由通用 /themes/<id>/ 路径提供，核心不把资源 alias 到某个主题。
# 主题切换后由前端根据 bootstrap.active_theme 选择对应模板和资源。
