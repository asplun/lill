# lill 博客系统 — Nginx 站点配置模板
#
# 使用前替换：
#   blog.example.com     → 你的域名
#   /www/wwwroot/lill    → 你的实际部署路径（1Panel 常见为 /opt/1panel/www/sites/lill）
#
# 宝塔：网站 → 站点 → 配置文件 → 整体替换
# 1Panel：网站 → 站点 → 配置文件 → 在 server{} 内加入 location 段（或整体替换）
#
# ⚠️ root 指向 frontend/，不是 frontend/dist/
#   后端按 THEMES_DIR = <项目根>/frontend/themes 读取主题模板，前端也通过
#   /themes/<id>/... 请求主题资源。二者必须指向同一棵树，否则会出现
#   “后台切了主题、前台还是旧样式”。
#   安装包已包含静态文件；源码构建后用 rsync -a --exclude='/themes/' dist/ ./ 同步。

server {
    listen 80;
    server_name blog.example.com;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name blog.example.com;

    # SSL 证书（宝塔一键申请后路径类似如下；1Panel 由面板自动管理，可省略）
    ssl_certificate     /www/server/panel/vhost/cert/blog.example.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/blog.example.com/privkey.pem;

    root /www/wwwroot/lill/frontend;
    index index.html;

    # 固定的是通用引擎入口；活动主题脚本由引擎按 bootstrap.themeId 加载。
    # 升级旧站时请移除指向 themes/<某主题>/theme.js 的历史 alias。
    location = /theme.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # ── 后端 API 反向代理 ──
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 160s;          # 备份请求的后端期限为 150 秒；普通 API 仍由后端 20 秒兜底
        client_max_body_size 50M;          # 媒体上传大小上限
    }

    # ── 上传文件由 Nginx 直接读取（绕过 Node，性能更好） ──
    location /uploads/ {
        alias /www/wwwroot/lill/backend/uploads/;
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
    }

    # ── 主题与构建产物：缺失即 404，禁止回退到 index.html ──
    # 这条很容易被忽略：一旦回退成首页，主题样式/脚本 404 时会返回一段 HTML，
    # 浏览器报 "Unexpected token '<'"、CSS 静默失效，排查起来非常费劲。
    # 主题服务端扩展与依赖不允许作为静态文件下载。
    location ~ ^/themes/[^/]+/(backend|node_modules)(/|$) {
        return 404;
    }
    location /themes/ {
        # 主题会被手工修改，强制带 ETag 回源校验，否则改了看不到效果
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location /_astro/ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
    location ~ ^/admin/.+\.(css|js|map|svg|png|ico|woff2?)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    # 源码和依赖文件保留在磁盘，但不作为站点资源提供。
    location ~ ^/(src|public|dist|node_modules)(/|$) { return 404; }
    location ~ ^/(package(-lock)?\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|astro\.config\.mjs)$ { return 404; }
    location ~ (^|/)\.(?!well-known(/|$)) { return 404; }

    # ── Typecho page paths resolve to the shared page shell ──
    location ~ ^/index\.php/(.+\.html)$ { rewrite ^/index\.php/(.+\.html)$ /page/index.html last; }
    location ~ ^/(.+\.html)$ { rewrite ^/(.+\.html)$ /page/index.html last; }

    # ── 动态路由回退到各自的静态壳 ──
    location /post/     { try_files $uri $uri/ /post/index.html; }
    location /category/ { try_files $uri $uri/ /category/index.html; }
    location /tag/      { try_files $uri $uri/ /tag/index.html; }
    location /page/     { try_files $uri $uri/ /page/index.html; }
    location /search/   { try_files $uri $uri/ /search/index.html; }
    location /admin/    {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /admin/index.html;
    }

    # ── RSS Feed ──
    location = /feed.xml {
        proxy_pass http://127.0.0.1:3000/api/v1/feed;
        proxy_set_header Host $host;
    }

    location = /sitemap.xml {
        proxy_pass http://127.0.0.1:3000/api/v1/sitemap.xml;
        proxy_set_header Host $host;
    }
    location = /robots.txt {
        proxy_pass http://127.0.0.1:3000/robots.txt;
        proxy_set_header Host $host;
    }

    location = /favicon.ico {
        try_files /favicon.svg =404;
    }

    # 应用内 404 外壳：仅内部跳转使用
    location = /404.html {
        internal;
        try_files $uri =404;
    }

    # 主题自定义页面请由主题自己的前端路由或 manifest 处理；核心不写死主题路径。

    # ── 前端静态文件 ──
    location / {
        # 路由壳与 api.js / theme.js 会被持续修改，统一回源校验
        add_header Cache-Control "no-cache";
        # 通用外壳按实际 pathname 请求 bootstrap，服务端解析永久链接。
        # 未知内容会返回 API 404，不会作为首页渲染。
        try_files $uri $uri/ /index.html;
    }
}

# 主题资源由通用 /themes/<id>/ 路径提供，核心不把资源 alias 到某个主题。
# 主题切换后由前端根据 bootstrap.active_theme 选择对应模板和资源。
